{
  "name": "watching-now-on-appletv",
  "version": "0.4.0",
  "private": true,
  "description": "Watching Now on AppleTV brings Apple TV playback to Discord Rich Presence.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/index.js",
    "desktop": "electron desktop/main.js",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "author": "benesch.dev",
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.benesch.watchingnow.appletv",
    "productName": "Watching Now on AppleTV",
    "asar": true,
    "files": [
      "src/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "Watching Now on AppleTV",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Watching-Now-on-AppleTV-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Watching Now on AppleTV"
    },
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "runtime/bin",
        "to": "runtime/bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
